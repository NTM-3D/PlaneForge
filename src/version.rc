#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     PF_VER_MAJOR,PF_VER_MINOR,PF_VER_PATCH,0
 PRODUCTVERSION  PF_VER_MAJOR,PF_VER_MINOR,PF_VER_PATCH,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "NTM-3D"
            VALUE "FileDescription",  "PlaneForge"
            VALUE "FileVersion",      PF_VERSION_FULL
            VALUE "InternalName",     "planeforge"
            VALUE "OriginalFilename", PF_EXE_NAME
            VALUE "ProductName",      "PlaneForge"
            VALUE "ProductVersion",   PF_VERSION
            VALUE "LegalCopyright",   "NTM-3D"
            VALUE "Author",           "NTM-3D"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END
